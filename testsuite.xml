<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PullApart Test Suite" parallel="methods" thread-count="3">

    <!-- Your existing API regression tests — unchanged -->
    <test name="API Regression Tests">
        <groups>
            <define name="regression">
                <include name="location"/>
                <include name="search"/>
                <include name="used_cars"/>
            </define>

            <define name="smoke">
                <include name="search"/>
            </define>

            <run>
                <include name="regression"/>
            </run>
        </groups>

        <packages>
            <package name="com.pullapart.api.tests"/>
        </packages>
    </test>

    <!-- Module 1: AI Test Generator -->
    <test name="AI Test Generator">
        <classes>
            <class name="com.synlee.pullapart.api.qforge.generator.TestGeneratorTest"/>
        </classes>
    </test>

    <!-- Module 2: LLM Response Validator -->
    <test name="LLM Response Validator">
        <classes>
            <class name="com.synlee.pullapart.api.qforge.validator.LlmValidatorTest"/>
        </classes>
    </test>

    <!-- Module 3: Chatbot Test Suite -->
    <test name="Chatbot Test Suite">
        <classes>
            <class name="com.synlee.pullapart.api.qforge.chatbot.ChatbotTest"/>
        </classes>
    </test>

</suite>